.env.local
.env.*.local
.env.production
.env.development

# ─── Build Outputs ───────────────────────────────────────────────────────────
node_modules
dist
dist-ssr

# ─── Logs ────────────────────────────────────────────────────────────────────
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Editor & IDE ────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db

# ─── Local Dev Cache ─────────────────────────────────────────────────────────
*.local
.cache

# ─── Local Excel Data Files (sensitif — tidak di-push) ───────────────────────
public/data/masterDatabase.json
src/data/*.xlsx
*.local.xlsx
extracted_online_sheets.json
