# ============================================================================
# TIRTA Dashboard — Environment Variables TEMPLATE
# Salin file ini ke ".env" dan isi nilainya. JANGAN commit .env ke Git!
# ============================================================================

# ─── DATABASE 1: Arus Komoditas Master (Tab 1-6) ─────────────────────────────
VITE_ONEDRIVE_MASTER_URL=

# ─── DATABASE 2: EWS / Early Warning System Alert (Tab 7, Standalone) ────────
VITE_ONEDRIVE_EWS_URL=

# ─── API Keys (untuk Serverless Functions di Vercel) ─────────────────────────
GROQ_API_KEY=
GROQ_API_KEY_SECONDARY=

# ─── Security / Auth ─────────────────────────────────────────────────────────
# SHA-256 hash dari PIN admin. Generate di: https://emn178.github.io/online-tools/sha256.html
VITE_ADMIN_PIN_HASH=

# ─── Feature Flags ───────────────────────────────────────────────────────────
VITE_APP_NAME=Dashboard Komoditas DIY
VITE_APP_VERSION=1.0.0
